// ─── Core: business units, identity, access control, audit, platform ───────────

model BusinessUnit {
  id          String   @id @default(cuid())
  code        UnitCode @unique
  name        String
  accentColor String // design-token hex, e.g. Academy violet, FigureWeb blue, Telecom amber
  timezone    String   @default("Africa/Lagos")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  primaryUsers     User[]
  memberships      UserUnit[]
  offices          Office[]
  contacts         Contact[]
  companies        Company[]
  pipelines        Pipeline[]
  deals            Deal[]
  forms            LeadForm[]
  sequences        EmailSequence[]
  broadcasts       Broadcast[]
  channels         InboxChannel[]
  conversations    Conversation[]
  routingRules     RoutingRule[]
  knowledge        KnowledgeArticle[]
  projects         Project[]
  tasks            Task[]
  sops             Sop[]
  dailyReports     DailyReport[]
  payments         Payment[]
  expenses         Expense[]
  invoices         Invoice[]
  bills            Bill[]
  bankAccounts     BankAccount[]
  recurringItems   RecurringItem[]
  subscriptions    Subscription[]
  resaleItems      ResaleItem[]
  domains          Domain[]
  documents        Document[]
  courses          Course[]
  tenders          Tender[]
  commissionRules  CommissionRule[]
  campaigns        AdCampaign[]
  utmLinks         UtmLink[]
  socialPosts      SocialPost[]
  tickets          Ticket[]
  chatChannels     ChatChannel[]
  latenessPolicies LatenessPolicy[]
}

enum UserStatus {
  INVITED
  ONBOARDING // contract pack unsigned → only attendance onboarding allowed
  ACTIVE
  SUSPENDED
  EXITED
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  name              String
  avatarFileId      String?
  passwordHash      String? // argon2id
  passwordChangedAt DateTime?
  status            UserStatus    @default(INVITED)
  roleId            String
  role              Role          @relation(fields: [roleId], references: [id])
  primaryUnitId     String?
  primaryUnit       BusinessUnit? @relation(fields: [primaryUnitId], references: [id])
  managerId         String?
  manager           User?         @relation("UserManager", fields: [managerId], references: [id])
  reports           User[]        @relation("UserManager")

  // 2FA (TOTP) — mandatory for admin/finance roles (Security #1)
  totpSecretEnc      String?
  twoFactorEnabledAt DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  sessionVersion     Int       @default(0) // bump → every session invalid (remote sign-out)
  lastLoginAt        DateTime?
  accessExpiresAt    DateTime? // e.g. external Auditor
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // access control
  units             UserUnit[]
  grants            UserGrant[]        @relation("GrantHolder")
  grantsIssued      UserGrant[]        @relation("GrantIssuer")
  sessions          UserSession[]
  recoveryCodes     RecoveryCode[]
  devices           Device[]           @relation("DeviceOwner")
  devicesApproved   Device[]           @relation("DeviceApprover")
  auditEntries      AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  filesUploaded     FileObject[]
  policyAcceptances PolicyAcceptance[]

  // HR
  staffProfile         StaffProfile?
  contractPacks        ContractPack[]
  exitCases            ExitCase[]     @relation("ExitStaff")
  exitCasesHandled     ExitCase[]     @relation("ExitHandler")
  payslips             Payslip[]
  deductions           Deduction[]
  payrollRunsApproved  PayrollRun[]   @relation("PayrollApprover")
  payrollRunsSignedOff PayrollRun[]   @relation("PayrollSignoff")
  payrollRunsPrepared  PayrollRun[]   @relation("PayrollPreparer")
  signatures           Signature[]

  // attendance
  attendanceDays  AttendanceDay[]
  punches         AttendancePunch[]  @relation("PunchOwner")
  punchesReviewed AttendancePunch[]  @relation("PunchReviewer")
  excuses         AttendanceExcuse[] @relation("ExcuseOwner")
  excusesReviewed AttendanceExcuse[] @relation("ExcuseReviewer")
  leaveRequests   LeaveRequest[]     @relation("LeaveOwner")
  leaveApprovals  LeaveRequest[]     @relation("LeaveApprover")

  // work
  tasksAssigned Task[]         @relation("TaskAssignee")
  tasksCreated  Task[]         @relation("TaskCreator")
  taskComments  TaskComment[]
  targets       WeeklyTarget[] @relation("TargetOwner")
  targetsSet    WeeklyTarget[] @relation("TargetSetter")
  dailyReports  DailyReport[]
  focusSessions FocusSession[]
  sopsOwned     Sop[]
  projectsOwned Project[]

  // CRM
  contactsOwned  Contact[]
  companiesOwned Company[]
  dealsOwned     Deal[]
  activities     Activity[]

  // inbox / AI
  conversationsAssigned Conversation[]           @relation("ConversationAssignee")
  assignmentEvents      ConversationAssignment[] @relation("AssignmentUser")
  assignmentsMade       ConversationAssignment[] @relation("AssignmentActor")
  messagesSent          Message[]
  conversationNotes     ConversationNote[]
  savedReplies          SavedReply[]
  routingMemberships    RoutingRuleMember[]
  routingEscalations    RoutingRule[]            @relation("RoutingEscalation")
  knowledgeAuthored     KnowledgeArticle[]

  // finance
  paymentsRecorded   Payment[]
  expensesSubmitted  Expense[]      @relation("ExpenseSubmitter")
  expensesApproved   Expense[]      @relation("ExpenseApprover")
  invoicesOwned      Invoice[]
  billsApproved      Bill[]
  subscriptionsOwned Subscription[]
  resaleItems        ResaleItem[]

  // telecom
  carriersManaged Carrier[]
  routesManaged   Route[]
  ratesCreated    Rate[]
  rateDecks       RateDeck[]
  trafficEntered  TrafficEntry[]
  cdrImports      CdrImport[]
  ledgerEntries   PrepaidLedgerEntry[]
  disputesOpened  Dispute[]

  // other modules
  documentsUploaded  Document[]           @relation("DocumentUploader")
  documentsAsStaff   Document[]           @relation("DocumentStaff")
  documentAccess     DocumentAccessLog[]
  certificatesIssued Certificate[]
  tendersOwned       Tender[]
  payoutsApproved    ReferralPayout[]
  ticketsAssigned    Ticket[]
  ticketComments     TicketComment[]
  chatMemberships    ChatMember[]
  chatMessages       ChatMessage[]
  chatMentions       ChatMention[]
  announcements      Announcement[]
  announcementAcks   AnnouncementAck[]
  dsrAssigned        DataSubjectRequest[]
  socialPosts        SocialPost[]
  sopAssignments     SopAssignee[]
}

/// Units a user may act within (in addition to primaryUnit). Drives the UNIT permission scope.
model UserUnit {
  userId String
  unitId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   BusinessUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
}

// Permission catalogue lives in code (src/server/authz/catalog.ts) so that
// modules/actions are type-checked; the DB stores which role holds what.
enum PermAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
}

enum PermScope {
  OWN
  UNIT
  ALL
}

model Role {
  id           String           @id @default(cuid())
  key          String           @unique // "super_admin", "finance", or a slug for custom roles
  name         String
  description  String?
  isSystem     Boolean          @default(false) // shipped default; can be edited, not deleted
  requires2fa  Boolean          @default(false)
  clonedFromId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        User[]
  permissions  RolePermission[]
}

model RolePermission {
  id     String     @id @default(cuid())
  roleId String
  role   Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module String // catalog key, e.g. "finance.invoices", "telecom.buy_rates"
  action PermAction
  scope  PermScope

  @@unique([roleId, module, action])
}

/// Individual extra grants on top of a role; may expire (temporary access).
model UserGrant {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation("GrantHolder", fields: [userId], references: [id], onDelete: Cascade)
  module      String
  action      PermAction
  scope       PermScope
  expiresAt   DateTime?
  reason      String?
  grantedById String
  grantedBy   User       @relation("GrantIssuer", fields: [grantedById], references: [id])
  createdAt   DateTime   @default(now())
  revokedAt   DateTime?

  @@index([userId, module])
}

/// Server-side session registry. The JWT carries sessionId; every request checks it is not revoked.
model UserSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  reauthAt    DateTime? // last step-up auth (finance/payroll actions require recent re-auth)
  revokedAt   DateTime?

  @@index([userId])
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  reason    String? // bad_password, locked, bad_totp, breached_password...
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

/// Registered phone for attendance device binding (one APPROVED per user).
model Device {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation("DeviceOwner", fields: [userId], references: [id], onDelete: Cascade)
  fingerprint  String // hash of device key stored in the phone's secure storage
  label        String?
  userAgent    String?
  status       DeviceStatus      @default(PENDING)
  approvedById String?
  approvedBy   User?             @relation("DeviceApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime          @default(now())
  punches      AttendancePunch[]

  @@unique([userId, fingerprint])
}

/// Append-only. A DB trigger (migration SQL) rejects UPDATE/DELETE; each row is hash-chained.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorType  String   @default("user") // user | system | webhook | ai
  action     String // "invoice.update", "rate.create", "role.permission.grant", "export.csv", "auth.login"
  entityType String?
  entityId   String?
  unitId     String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  prevHash   String?
  hash       String

  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([action, at])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // task.assigned, sla.breach, renewal.due, mention...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  emailedAt DateTime?
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id // "telecom.margin_alert_pct", "finance.min_cash_balance", "payroll.signoff_limit"
  value     Json
  updatedAt DateTime @updatedAt
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// Every uploaded file. Bytes live in private object storage; served only via signed expiring URLs.
model FileObject {
  id           String     @id @default(cuid())
  storageKey   String     @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  purpose      String // selfie, receipt, cdr, contract, attachment, avatar, certificate
  scanStatus   ScanStatus @default(PENDING)
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([sha256]) // also used to detect selfie re-use
}

enum IntegrationProvider {
  PAYSTACK
  WHMCS
  BREVO
  META
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  META_ADS
  LINKEDIN
  GEMINI
  GROQ
  IMAP
  SMS
}

/// Third-party connection. Tokens encrypted at rest (Security #17). Static API keys stay in .env.
model IntegrationConnection {
  id            String              @id @default(cuid())
  provider      IntegrationProvider
  label         String
  unitId        String?
  externalId    String? // page id, WABA phone-number id, ad account id
  scopes        String[]
  tokenEnc      String?
  refreshEnc    String?
  expiresAt     DateTime?
  rotatedAt     DateTime?
  lastUsedAt    DateTime?
  status        String              @default("active")
  createdAt     DateTime            @default(now())
  inboxChannels InboxChannel[]

  @@unique([provider, externalId])
}

/// Inbound webhook log: signature result + replay protection via unique (provider, eventId).
model WebhookEvent {
  id             String              @id @default(cuid())
  provider       IntegrationProvider
  eventId        String
  eventType      String
  signatureValid Boolean
  payload        Json
  receivedAt     DateTime            @default(now())
  processedAt    DateTime?
  status         String              @default("received") // received | processed | rejected | failed
  error          String?

  @@unique([provider, eventId])
}

model ExchangeRate {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  base   Currency
  quote  Currency
  rate   Decimal  @db.Decimal(18, 6)
  source String   @default("manual")

  @@unique([date, base, quote])
}
