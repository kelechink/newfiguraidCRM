// Figuraid OS v2 — Prisma schema (multi-file). One file per module.
// Conventions:
//   • ids are cuid() strings (non-sequential, IDOR-resistant — Security #3)
//   • every business record carries unitId + an owner/responsible user
//   • money: Decimal(18,2); telecom rates: Decimal(14,6); rated telecom amounts: Decimal(18,4)
//   • fields ending in `Enc` hold AES-256-GCM ciphertext ("v1:<iv>:<tag>:<ct>") — Security #13
//   • soft delete via deletedAt where records must survive for audit

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  NGN
  USD
  GBP
  EUR
}

enum UnitCode {
  ACADEMY
  FIGUREWEB
  TELECOM
  HQ
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
