// ─── Module C: CRM, leads and pipelines ────────────────────────────────────────

enum LifecycleStage {
  LEAD
  QUALIFIED
  CUSTOMER
  CHURNED
  ARCHIVED
}

enum LeadChannel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  EMAIL
  WEBCHAT
  LINKEDIN
  PHONE
  SMS
  FORM
  REFERRAL
  META_AD
  WALK_IN
  TENDER
  IMPORT
  OTHER
}

model Company {
  id        String       @id @default(cuid())
  unitId    String
  unit      BusinessUnit @relation(fields: [unitId], references: [id])
  ownerId   String?
  owner     User?        @relation(fields: [ownerId], references: [id])
  name      String
  domain    String?
  industry  String?
  phone     String?
  address   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  contacts  Contact[]
  deals     Deal[]
  invoices  Invoice[]
  documents Document[]

  @@index([unitId, name])
}

model Contact {
  id              String         @id @default(cuid())
  unitId          String
  unit            BusinessUnit   @relation(fields: [unitId], references: [id])
  ownerId         String?
  owner           User?          @relation(fields: [ownerId], references: [id])
  companyId       String?
  company         Company?       @relation(fields: [companyId], references: [id])
  firstName       String?
  lastName        String?
  displayName     String
  email           String?
  emailNormalized String? // lower-cased; duplicate detection
  phone           String?
  phoneE164       String? // normalised; duplicate detection + WhatsApp matching
  whatsappId      String?
  instagramId     String?
  facebookPsid    String?
  linkedinId      String?
  lifecycle       LifecycleStage @default(LEAD)
  score           Int            @default(0) // lead scoring: activity + source + budget
  budget          Decimal?       @db.Decimal(18, 2)
  // attribution (first touch)
  sourceChannel   LeadChannel?
  sourceDetail    String?
  campaignId      String?
  campaign        AdCampaign?    @relation(fields: [campaignId], references: [id])
  adId            String?
  formId          String?
  form            LeadForm?      @relation(fields: [formId], references: [id])
  referralCode    String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  lastActivityAt  DateTime?
  mergedIntoId    String? // set when merged as duplicate
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  tags               ContactTag[]
  deals              Deal[]
  activities         Activity[]
  conversations      Conversation[]
  formSubmissions    FormSubmission[]
  enrollments        SequenceEnrollment[]
  emailMessages      EmailMessage[]
  consents           Consent[]
  invoices           Invoice[]
  payments           Payment[]
  tickets            Ticket[]
  resaleItems        ResaleItem[]
  domains            Domain[]
  documents          Document[]
  studentEnrollments CourseEnrollment[]
  referrer           Referrer?
  referralsMade      Referral[]
  dsrs               DataSubjectRequest[]

  @@index([unitId, lifecycle])
  @@index([emailNormalized])
  @@index([phoneE164])
  @@index([ownerId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  color    String?
  contacts ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Pipeline {
  id        String          @id @default(cuid())
  unitId    String
  unit      BusinessUnit    @relation(fields: [unitId], references: [id])
  name      String
  kind      String          @default("sales") // sales | tender
  isDefault Boolean         @default(false)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  stages    PipelineStage[]
  deals     Deal[]
  forms     LeadForm[]
}

enum StageKind {
  OPEN
  WON
  LOST
}

model PipelineStage {
  id          String     @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  probability Int        @default(0) // default win % for weighted pipeline / cash-flow forecast
  kind        StageKind  @default(OPEN)
  color       String?
  deals       Deal[]
  forms       LeadForm[]

  @@unique([pipelineId, position])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Deal {
  id                String        @id @default(cuid())
  unitId            String
  unit              BusinessUnit  @relation(fields: [unitId], references: [id])
  pipelineId        String
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  contactId         String?
  contact           Contact?      @relation(fields: [contactId], references: [id])
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id])
  ownerId           String?
  owner             User?         @relation(fields: [ownerId], references: [id])
  title             String
  value             Decimal       @default(0) @db.Decimal(18, 2)
  currency          Currency      @default(NGN)
  probability       Int? // overrides stage probability when set
  expectedCloseDate DateTime?
  status            DealStatus    @default(OPEN)
  lostReasonId      String?
  lostReason        LostReason?   @relation(fields: [lostReasonId], references: [id])
  lostNote          String?
  wonAt             DateTime?
  lostAt            DateTime?
  rank              String // fractional index for Kanban ordering within a stage
  sourceChannel     LeadChannel?
  campaignId        String?
  campaign          AdCampaign?   @relation(fields: [campaignId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  activities        Activity[]
  invoices          Invoice[]
  referral          Referral?
  carrier           Carrier?      @relation(fields: [carrierId], references: [id])
  carrierId         String? // telecom deals attributed to a carrier

  @@index([pipelineId, stageId, rank])
  @@index([unitId, status])
  @@index([ownerId])
}

model LostReason {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
  deals  Deal[]
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  MESSAGE
  STAGE_CHANGED
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
  INVOICE
  PAYMENT
  TICKET
  FORM_SUBMITTED
  MERGED
  MISSED_CALL
  SMS
}

/// Unified contact timeline.
model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id])
  summary    String
  data       Json?
  refType    String? // invoice | ticket | conversation | email
  refId      String?
  occurredAt DateTime     @default(now())

  @@index([contactId, occurredAt])
  @@index([dealId, occurredAt])
}

/// Forms, surveys and landing-page capture feeding a pipeline stage.
model LeadForm {
  id          String           @id @default(cuid())
  unitId      String
  unit        BusinessUnit     @relation(fields: [unitId], references: [id])
  name        String
  slug        String           @unique
  kind        String           @default("form") // form | survey | landing
  fields      Json // [{key,label,type,required,options}]
  pipelineId  String?
  pipeline    Pipeline?        @relation(fields: [pipelineId], references: [id])
  stageId     String?
  stage       PipelineStage?   @relation(fields: [stageId], references: [id])
  consentText String? // shown with marketing opt-in checkbox
  noticeId    String? // public privacy notice shown on the form
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  submissions FormSubmission[]
  contacts    Contact[]
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  data      Json
  ip        String?
  userAgent String?
  utm       Json?
  createdAt DateTime @default(now())
}
