// ─── Module G: Staff OS — tasks, targets, SOPs, daily reports ─────────────────

model Project {
  id            String         @id @default(cuid())
  unitId        String
  unit          BusinessUnit   @relation(fields: [unitId], references: [id])
  name          String
  ownerId       String?
  owner         User?          @relation(fields: [ownerId], references: [id])
  status        String         @default("active")
  createdAt     DateTime       @default(now())
  tasks         Task[]
  focusSessions FocusSession[]
  chatChannels  ChatChannel[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskSource {
  MANUAL
  TARGET // auto-derived from weekly target
  CHAT // created from an internal message
  CONVERSATION // created from inbox / AI routing
  TICKET
  SYSTEM // reminders, renewals
}

/// Who a task comes from — shown as a badge and filter on the board. Derived server-side, never user-chosen.
enum TaskOrigin {
  FOUNDER // created by the Super Admin (CEO)
  TEAM_LEAD // created by a manager / ops manager / anyone else allowed to assign work
  SOP // generated from an SOP template's schedule
}

model Task {
  id               String              @id @default(cuid())
  unitId           String
  unit             BusinessUnit        @relation(fields: [unitId], references: [id])
  projectId        String?
  project          Project?            @relation(fields: [projectId], references: [id])
  title            String
  description      String?
  status           TaskStatus          @default(TODO)
  priority         Priority            @default(MEDIUM)
  dueAt            DateTime?
  assigneeId       String?
  assignee         User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById      String
  createdBy        User                @relation("TaskCreator", fields: [createdById], references: [id])
  origin           TaskOrigin
  source           TaskSource          @default(MANUAL)
  boardRank        String // fractional index: order within a board column
  targetId         String?
  target           WeeklyTarget?       @relation(fields: [targetId], references: [id])
  sopId            String?
  sop              Sop?                @relation(fields: [sopId], references: [id])
  conversationId   String?
  conversation     Conversation?       @relation(fields: [conversationId], references: [id])
  chatMessageId    String?             @unique
  chatMessage      ChatMessage?        @relation("MessageTask", fields: [chatMessageId], references: [id])
  ticketId         String?
  ticket           Ticket?             @relation(fields: [ticketId], references: [id])
  sopOccurrenceKey String? // "2026-10-22:<assigneeId>" — makes SOP generation idempotent
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  comments         TaskComment[]
  checklist        TaskChecklistItem[]
  attachments      TaskAttachment[]

  @@unique([sopId, sopOccurrenceKey])
  @@index([assigneeId, status, dueAt])
  @@index([unitId, status, boardRank])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  mentions  String[]
  createdAt DateTime @default(now())
}

model TaskChecklistItem {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  position  Int
  label     String
  doneAt    DateTime?
  sopStepId String?
}

model TaskAttachment {
  taskId String
  fileId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, fileId])
}

enum SopFrequency {
  DAILY // every working day (Mon–Fri)
  WEEKLY // on the chosen weekdays
  MONTHLY // on dayOfMonth (clamped to month end)
  ON_DEMAND // template only; tasks created manually from it
}

/// SOP template: step-by-step procedure + a schedule that "Generate due tasks" turns into tasks.
model Sop {
  id              String        @id @default(cuid())
  unitId          String
  unit            BusinessUnit  @relation(fields: [unitId], references: [id])
  title           String
  summary         String?
  ownerId         String?
  owner           User?         @relation(fields: [ownerId], references: [id])
  version         Int           @default(1)
  isActive        Boolean       @default(true)
  frequency       SopFrequency  @default(WEEKLY)
  weekdays        Int[]         @default([1]) // ISO weekday 1=Mon … 7=Sun, used by WEEKLY
  dayOfMonth      Int? // used by MONTHLY
  dueTime         String        @default("17:00") // HH:mm, Africa/Lagos
  defaultPriority Priority      @default(MEDIUM)
  startsOn        DateTime      @default(now()) @db.Date
  lastGeneratedOn DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  steps           SopStep[]
  assignees       SopAssignee[]
  tasks           Task[]
}

/// Each assignee receives their own task per occurrence.
model SopAssignee {
  sopId  String
  userId String
  sop    Sop    @relation(fields: [sopId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sopId, userId])
}

model SopStep {
  id       String  @id @default(cuid())
  sopId    String
  sop      Sop     @relation(fields: [sopId], references: [id], onDelete: Cascade)
  position Int
  title    String
  detail   String?

  @@unique([sopId, position])
}

enum TargetMetric {
  LEADS_CONTACTED
  DEALS_CLOSED
  REVENUE
  MINUTES_SOLD
  TICKETS_RESOLVED
  CONVERSATIONS_HANDLED
  STUDENTS_ENROLLED
  CUSTOM
}

model WeeklyTarget {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation("TargetOwner", fields: [userId], references: [id])
  unitId      String
  weekStart   DateTime     @db.Date // Monday
  metric      TargetMetric
  label       String? // for CUSTOM
  targetValue Decimal      @db.Decimal(18, 2)
  achieved    Decimal      @default(0) @db.Decimal(18, 2) // recomputed from source data nightly + on events
  bonusAmount Decimal?     @db.Decimal(18, 2) // paid via payroll if achieved ≥ target
  setById     String
  setBy       User         @relation("TargetSetter", fields: [setById], references: [id])
  createdAt   DateTime     @default(now())
  tasks       Task[]

  @@unique([userId, weekStart, metric, label])
}

model DailyReport {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  unitId       String
  unit         BusinessUnit @relation(fields: [unitId], references: [id])
  date         DateTime     @db.Date
  accomplished String
  blockers     String?
  tomorrow     String?
  submittedAt  DateTime     @default(now())

  @@unique([userId, date])
}

/// "Which unit/project am I working on" — work is logged against the active focus.
model FocusSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
}
