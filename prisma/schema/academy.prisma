// ─── Figure Academy: courses, cohorts, students · Module N: certificates ──────

model Course {
  id          String       @id @default(cuid())
  unitId      String
  unit        BusinessUnit @relation(fields: [unitId], references: [id])
  code        String       @unique
  title       String
  description String?
  priceNgn    Decimal?     @db.Decimal(18, 2)
  isActive    Boolean      @default(true)
  cohorts     Cohort[]
}

model Cohort {
  id          String             @id @default(cuid())
  courseId    String
  course      Course             @relation(fields: [courseId], references: [id])
  name        String // "AI Foundations — Cohort 4"
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  capacity    Int?
  status      String             @default("planned") // planned | running | completed
  enrollments CourseEnrollment[]
}

enum EnrollmentState {
  APPLIED
  SCREENED
  ENROLLED
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model CourseEnrollment {
  id              String          @id @default(cuid())
  cohortId        String
  cohort          Cohort          @relation(fields: [cohortId], references: [id])
  contactId       String
  contact         Contact         @relation(fields: [contactId], references: [id])
  state           EnrollmentState @default(APPLIED)
  scholarshipPct  Int             @default(0)
  scholarshipNote String?
  amountDue       Decimal?        @db.Decimal(18, 2)
  attendancePct   Decimal?        @db.Decimal(5, 2)
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  certificates    Certificate[]

  @@unique([cohortId, contactId])
}

enum CertificateStatus {
  VALID
  REVOKED
  SUPERSEDED // reissued
}

/// Public verification at /verify/{code} shows only name, course, cohort, date, status.
model Certificate {
  id             String            @id @default(cuid())
  code           String            @unique // random, unguessable (e.g. FA-7KQ2-M9XD-P4TA)
  enrollmentId   String
  enrollment     CourseEnrollment  @relation(fields: [enrollmentId], references: [id])
  recipientName  String
  courseTitle    String
  cohortName     String
  issuedOn       DateTime          @db.Date
  status         CertificateStatus @default(VALID)
  revokedReason  String?
  revokedAt      DateTime?
  reissuedFromId String?           @unique
  reissuedFrom   Certificate?      @relation("Reissue", fields: [reissuedFromId], references: [id])
  reissuedAs     Certificate?      @relation("Reissue")
  pdfFileId      String?
  issuedById     String
  issuedBy       User              @relation(fields: [issuedById], references: [id])
  createdAt      DateTime          @default(now())
}
