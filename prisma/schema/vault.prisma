// ─── Module O: Contract & document vault + in-app e-signature ─────────────────

enum DocumentCategory {
  CARRIER_AGREEMENT
  CLIENT_CONTRACT
  NDA
  OFFER_LETTER
  STAFF_CONTRACT
  CAC
  COMPLIANCE
  TENDER
  POLICY
  OTHER
}

enum DocumentStatus {
  DRAFT
  AWAITING_SIGNATURE
  PARTIALLY_SIGNED
  SIGNED
  EXPIRED
  ARCHIVED
}

model Document {
  id               String              @id @default(cuid())
  title            String
  category         DocumentCategory
  status           DocumentStatus      @default(DRAFT)
  unitId           String?
  unit             BusinessUnit?       @relation(fields: [unitId], references: [id])
  fileId           String? // current rendered PDF
  contentHash      String? // sha256 of the exact content signed
  renderedBody     String? // frozen merged text for contract-pack docs (template edits never alter it)
  templateId       String?
  template         ContractTemplate?   @relation(fields: [templateId], references: [id])
  packId           String?
  pack             ContractPack?       @relation(fields: [packId], references: [id])
  // links
  carrierId        String?
  carrier          Carrier?            @relation(fields: [carrierId], references: [id])
  companyId        String?
  company          Company?            @relation(fields: [companyId], references: [id])
  contactId        String?
  contact          Contact?            @relation(fields: [contactId], references: [id])
  staffUserId      String?
  staffUser        User?               @relation("DocumentStaff", fields: [staffUserId], references: [id])
  tenderId         String?
  tender           Tender?             @relation(fields: [tenderId], references: [id])
  // lifecycle
  effectiveOn      DateTime?
  expiresOn        DateTime?
  renewalAlertDays Int                 @default(30)
  restrictedTo     String[] // role keys allowed beyond module permission (e.g. ["super_admin"])
  uploadedById     String?
  uploadedBy       User?               @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  signatures       Signature[]
  accessLog        DocumentAccessLog[]

  @@index([category, expiresOn])
}

enum SignerRole {
  STAFF
  COMPANY // Super Admin countersignature
  COUNTERPARTY // carrier / client
}

/// Signature request + evidence. External signers use a single-use hashed token link.
model Signature {
  id                   String     @id @default(cuid())
  documentId           String
  document             Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role                 SignerRole
  order                Int        @default(1)
  signerId             String?
  signer               User?      @relation(fields: [signerId], references: [id])
  signerName           String
  signerEmail          String
  tokenHash            String?    @unique
  tokenExpiresAt       DateTime?
  status               String     @default("pending") // pending | signed | declined
  signedAt             DateTime?
  ip                   String?
  userAgent            String?
  signatureImageFileId String?
  typedName            String?
  contentHash          String? // hash of document content at signing time
}

model DocumentAccessLog {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // view | download | share
  ip         String?
  at         DateTime @default(now())

  @@index([documentId, at])
}
