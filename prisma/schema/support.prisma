// ─── Module I: Customer support ───────────────────────────────────────────────

enum TicketStatus {
  NEW
  OPEN
  PENDING_CUSTOMER
  ON_HOLD
  RESOLVED
  CLOSED
}

model Ticket {
  id                 String             @id @default(cuid())
  number             String             @unique // display only
  unitId             String
  unit               BusinessUnit       @relation(fields: [unitId], references: [id])
  contactId          String
  contact            Contact            @relation(fields: [contactId], references: [id])
  conversationId     String?
  conversation       Conversation?      @relation(fields: [conversationId], references: [id])
  source             String // inbox | email | web_form
  subject            String
  category           String?
  priority           Priority           @default(MEDIUM)
  status             TicketStatus       @default(NEW)
  assigneeId         String?
  assignee           User?              @relation(fields: [assigneeId], references: [id])
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  csatScore          Int? // 1–5
  csatComment        String?
  csatTokenHash      String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  comments           TicketComment[]
  articles           KnowledgeArticle[]
  tasks              Task[]

  @@index([unitId, status])
  @@index([assigneeId, status])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  isPublic  Boolean  @default(false) // public = sent to customer
  body      String
  createdAt DateTime @default(now())
}
