// ─── Module F: Finance · subscriptions · procurement · Module M inputs ────────

model BankAccount {
  id               String                @id @default(cuid())
  unitId           String?
  unit             BusinessUnit?         @relation(fields: [unitId], references: [id])
  name             String // "GTBank NGN Operating"
  bankName         String
  accountNoEnc     String // encrypted (Security #13)
  accountLast4     String
  currency         Currency
  openingBalance   Decimal               @default(0) @db.Decimal(18, 2)
  isActive         Boolean               @default(true)
  payments         Payment[]
  expenses         Expense[]
  balanceSnapshots BankBalanceSnapshot[]
}

/// Reconciled balance as at a date — "cash in bank" KPI and forecast starting point.
model BankBalanceSnapshot {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  asOf          DateTime
  balance       Decimal     @db.Decimal(18, 2)
  source        String      @default("manual")
}

enum PaymentMethod {
  PAYSTACK
  WHMCS
  BANK_TRANSFER
  CASH
  POS
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING_RECONCILIATION // webhook received, not yet verified against provider API
  CONFIRMED
  REFUNDED
  FAILED
}

/// Money in. Paystack/WHMCS rows are created from verified webhooks only (Security #6).
model Payment {
  id               String          @id @default(cuid())
  unitId           String
  unit             BusinessUnit    @relation(fields: [unitId], references: [id])
  amount           Decimal         @db.Decimal(18, 2)
  currency         Currency
  fxRate           Decimal?        @db.Decimal(18, 6) // to NGN; required when currency ≠ NGN
  amountNgn        Decimal         @db.Decimal(18, 2)
  method           PaymentMethod
  status           PaymentStatus   @default(CONFIRMED)
  providerRef      String? // Paystack reference / WHMCS transaction id
  invoiceId        String?
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id])
  contactId        String?
  contact          Contact?        @relation(fields: [contactId], references: [id])
  carrierAccountId String?
  carrierAccount   CarrierAccount? @relation(fields: [carrierAccountId], references: [id])
  bankAccountId    String?
  bankAccount      BankAccount?    @relation(fields: [bankAccountId], references: [id])
  description      String?
  receivedAt       DateTime
  reconciledAt     DateTime?
  recordedById     String?
  recordedBy       User?           @relation(fields: [recordedById], references: [id])
  createdAt        DateTime        @default(now())

  @@unique([method, providerRef])
  @@index([unitId, receivedAt])
}

model ExpenseCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  isActive  Boolean         @default(true)
  expenses  Expense[]
  recurring RecurringItem[]
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id             String          @id @default(cuid())
  unitId         String
  unit           BusinessUnit    @relation(fields: [unitId], references: [id])
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  description    String
  vendor         String?
  amount         Decimal         @db.Decimal(18, 2)
  currency       Currency
  fxRate         Decimal?        @db.Decimal(18, 6)
  amountNgn      Decimal         @db.Decimal(18, 2)
  incurredOn     DateTime
  receiptFileId  String?
  status         ExpenseStatus   @default(DRAFT)
  submittedById  String
  submittedBy    User            @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  approvedById   String?
  approvedBy     User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectionNote  String?
  paidAt         DateTime?
  bankAccountId  String?
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id])
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  referralPayout ReferralPayout?
  createdAt      DateTime        @default(now())

  @@index([unitId, incurredOn])
  @@index([status])
}

enum InvoiceKind {
  INVOICE
  QUOTE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  ACCEPTED // quotes
  DECLINED // quotes
}

/// Accounts receivable: client invoices, quotes, and telecom customer invoices.
model Invoice {
  id               String          @id @default(cuid())
  number           String          @unique // FIG-ACA-2026-0001 (display only; never used for access)
  kind             InvoiceKind     @default(INVOICE)
  status           InvoiceStatus   @default(DRAFT)
  unitId           String
  unit             BusinessUnit    @relation(fields: [unitId], references: [id])
  ownerId          String?
  owner            User?           @relation(fields: [ownerId], references: [id])
  contactId        String?
  contact          Contact?        @relation(fields: [contactId], references: [id])
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id])
  dealId           String?
  deal             Deal?           @relation(fields: [dealId], references: [id])
  carrierAccountId String?
  carrierAccount   CarrierAccount? @relation(fields: [carrierAccountId], references: [id])
  periodStart      DateTime? // telecom billing cycle
  periodEnd        DateTime?
  currency         Currency
  fxRate           Decimal?        @db.Decimal(18, 6)
  subtotal         Decimal         @db.Decimal(18, 2)
  vatRate          Decimal         @default(0) @db.Decimal(5, 2) // 7.5 for Nigeria VAT
  vatAmount        Decimal         @default(0) @db.Decimal(18, 2)
  total            Decimal         @db.Decimal(18, 2)
  amountPaid       Decimal         @default(0) @db.Decimal(18, 2)
  issueDate        DateTime
  dueDate          DateTime
  notes            String?
  sentAt           DateTime?
  paidAt           DateTime?
  paystackLinkRef  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lines            InvoiceLine[]
  payments         Payment[]
  traffic          TrafficEntry[]
  disputes         Dispute[]

  @@index([unitId, status, dueDate])
  @@index([carrierAccountId, periodStart])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 6)
  amount      Decimal @db.Decimal(18, 2)
  vatable     Boolean @default(true)
}

enum BillStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  DISPUTED
  VOID
}

/// Accounts payable: supplier bills and telecom vendor payable statements.
model Bill {
  id               String          @id @default(cuid())
  number           String?
  unitId           String
  unit             BusinessUnit    @relation(fields: [unitId], references: [id])
  supplierName     String?
  carrierAccountId String?
  carrierAccount   CarrierAccount? @relation(fields: [carrierAccountId], references: [id])
  periodStart      DateTime?
  periodEnd        DateTime?
  currency         Currency
  fxRate           Decimal?        @db.Decimal(18, 6)
  total            Decimal         @db.Decimal(18, 2)
  amountPaid       Decimal         @default(0) @db.Decimal(18, 2)
  issueDate        DateTime
  dueDate          DateTime
  status           BillStatus      @default(DRAFT)
  approvedById     String?
  approvedBy       User?           @relation(fields: [approvedById], references: [id])
  fileId           String?
  createdAt        DateTime        @default(now())
  traffic          TrafficEntry[]
  disputes         Dispute[]

  @@index([unitId, status, dueDate])
}

enum Recurrence {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// Recurring expenses not covered elsewhere (rent, utilities) — cash-flow forecast input.
model RecurringItem {
  id         String           @id @default(cuid())
  unitId     String
  unit       BusinessUnit     @relation(fields: [unitId], references: [id])
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  name       String
  amount     Decimal          @db.Decimal(18, 2)
  currency   Currency
  recurrence Recurrence
  nextDueOn  DateTime
  isActive   Boolean          @default(true)
}

// ── Subscriptions tracker ──

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
  PAUSED
}

model Subscription {
  id          String             @id @default(cuid())
  name        String
  vendor      String
  category    String?
  unitId      String
  unit        BusinessUnit       @relation(fields: [unitId], references: [id])
  ownerId     String?
  owner       User?              @relation(fields: [ownerId], references: [id])
  cost        Decimal            @db.Decimal(18, 2)
  currency    Currency
  recurrence  Recurrence
  renewalDate DateTime
  cardLast4   String? // never the full PAN
  seats       Int?
  lastUsedAt  DateTime? // unused-tool flag
  status      SubscriptionStatus @default(ACTIVE)
  notes       String?
  remindedAt7 DateTime?
  remindedAt1 DateTime?
  createdAt   DateTime           @default(now())
  expenses    Expense[]

  @@index([renewalDate])
}

// ── Procurement / resale margin ──

model Supplier {
  id        String          @id @default(cuid())
  name      String          @unique
  kind      String? // registrar | host | licence | ssl | services
  website   String?
  createdAt DateTime        @default(now())
  items     ResaleItem[]
  domains   Domain[]
  prices    SupplierPrice[]
}

enum ResaleType {
  DOMAIN
  HOSTING
  EMAIL
  LICENCE
  SSL
  SERVICE
  OTHER
}

model ResaleItem {
  id           String       @id @default(cuid())
  unitId       String
  unit         BusinessUnit @relation(fields: [unitId], references: [id])
  type         ResaleType
  description  String
  supplierId   String
  supplier     Supplier     @relation(fields: [supplierId], references: [id])
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id])
  costPrice    Decimal      @db.Decimal(18, 2)
  salePrice    Decimal      @db.Decimal(18, 2)
  currency     Currency
  fxRate       Decimal?     @db.Decimal(18, 6)
  purchasedOn  DateTime
  recordedById String
  recordedBy   User         @relation(fields: [recordedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([supplierId])
}

model Domain {
  id           String       @id @default(cuid())
  name         String       @unique
  unitId       String
  unit         BusinessUnit @relation(fields: [unitId], references: [id])
  registrarId  String
  registrar    Supplier     @relation(fields: [registrarId], references: [id])
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id])
  costPrice    Decimal      @db.Decimal(18, 2)
  sellPrice    Decimal      @db.Decimal(18, 2)
  currency     Currency
  registeredOn DateTime?
  expiresOn    DateTime
  autoRenew    Boolean      @default(false)
  whmcsId      String?
  status       String       @default("active")
  createdAt    DateTime     @default(now())

  @@index([expiresOn])
}

/// Price points per supplier for comparison ("buy from the cheapest").
model SupplierPrice {
  id         String     @id @default(cuid())
  supplierId String
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productKey String // ".com.ng registration", "cPanel 10GB", "PositiveSSL"
  type       ResaleType
  price      Decimal    @db.Decimal(18, 2)
  currency   Currency
  checkedOn  DateTime

  @@index([productKey])
}

/// Exchange rates to naira, append-only history. Every money view converts with the
/// latest rate per currency; each transaction still keeps the rate captured on it.
model FxRate {
  id        String   @id @default(cuid())
  currency  Currency
  rateToNgn Decimal  @db.Decimal(18, 6) // ₦ per 1 unit of currency
  source    String // manual | api
  asOf      DateTime @default(now())
  setById   String?
  setBy     User?    @relation("FxRateSetter", fields: [setById], references: [id])

  @@index([currency, asOf])
}
