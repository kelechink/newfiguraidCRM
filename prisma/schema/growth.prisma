// ─── Module P: Tenders · Module Q: Referrals · Module J: Marketing & ads ──────

enum TenderStage {
  IDENTIFIED
  CONTACT_MADE
  PROPOSAL_DRAFTED
  SUBMITTED
  PRESENTATION
  AWARDED
  LOST
}

model Tender {
  id             String                @id @default(cuid())
  unitId         String
  unit           BusinessUnit          @relation(fields: [unitId], references: [id])
  title          String
  agency         String // ministry / agency
  state          String                @default("Akwa Ibom")
  reference      String?
  contacts       Json? // [{name, role, phone, email}]
  deadline       DateTime
  estimatedValue Decimal?              @db.Decimal(18, 2)
  currency       Currency              @default(NGN)
  stage          TenderStage           @default(IDENTIFIED)
  ownerId        String
  owner          User                  @relation(fields: [ownerId], references: [id])
  outcomeNote    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  checklist      TenderChecklistItem[]
  documents      Document[]

  @@index([stage, deadline])
}

model TenderChecklistItem {
  id       String    @id @default(cuid())
  tenderId String
  tender   Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  label    String // "CAC certificate", "Tax clearance", "PENCOM", "ITF"
  required Boolean   @default(true)
  fileId   String?
  doneAt   DateTime?
}

enum ReferrerType {
  CUSTOMER
  GRADUATE
  PARTNER
}

model Referrer {
  id        String           @id @default(cuid())
  type      ReferrerType
  contactId String?          @unique
  contact   Contact?         @relation(fields: [contactId], references: [id])
  name      String
  email     String?
  code      String           @unique // used in ?ref=CODE links
  status    String           @default("active")
  createdAt DateTime         @default(now())
  referrals Referral[]
  payouts   ReferralPayout[]
}

enum CommissionType {
  PERCENT
  FIXED
}

model CommissionRule {
  id        String         @id @default(cuid())
  unitId    String
  unit      BusinessUnit   @relation(fields: [unitId], references: [id])
  type      CommissionType
  value     Decimal        @db.Decimal(18, 2)
  currency  Currency       @default(NGN)
  isActive  Boolean        @default(true)
  validFrom DateTime       @default(now())
}

model Referral {
  id               String          @id @default(cuid())
  referrerId       String
  referrer         Referrer        @relation(fields: [referrerId], references: [id])
  contactId        String
  contact          Contact         @relation(fields: [contactId], references: [id])
  dealId           String?         @unique
  deal             Deal?           @relation(fields: [dealId], references: [id])
  status           String          @default("referred") // referred | qualified | won | lost | paid
  commissionAmount Decimal?        @db.Decimal(18, 2)
  payoutId         String?
  payout           ReferralPayout? @relation(fields: [payoutId], references: [id])
  createdAt        DateTime        @default(now())
}

model ReferralPayout {
  id           String         @id @default(cuid())
  referrerId   String
  referrer     Referrer       @relation(fields: [referrerId], references: [id])
  amount       Decimal        @db.Decimal(18, 2)
  currency     Currency       @default(NGN)
  status       ApprovalStatus @default(PENDING)
  approvedById String?
  approvedBy   User?          @relation(fields: [approvedById], references: [id])
  approvedAt   DateTime?
  expenseId    String?        @unique // recorded in finance on approval
  expense      Expense?       @relation(fields: [expenseId], references: [id])
  createdAt    DateTime       @default(now())
  referrals    Referral[]
}

// ── Marketing & ads (Meta only) ──

model AdCampaign {
  id         String           @id @default(cuid())
  unitId     String
  unit       BusinessUnit     @relation(fields: [unitId], references: [id])
  platform   String           @default("meta")
  externalId String?          @unique
  name       String
  objective  String?
  status     String           @default("active")
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime         @default(now())
  ads        Ad[]
  insights   AdInsightDaily[]
  contacts   Contact[]
  deals      Deal[]
  utmLinks   UtmLink[]
}

model Ad {
  id         String           @id @default(cuid())
  campaignId String
  campaign   AdCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId String?          @unique
  name       String
  insights   AdInsightDaily[]
}

/// Synced from Meta Marketing API; revenue/ROI computed by joining Deals & Payments via attribution.
model AdInsightDaily {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adId        String?
  ad          Ad?        @relation(fields: [adId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  spend       Decimal    @db.Decimal(18, 2)
  currency    Currency
  impressions Int        @default(0)
  clicks      Int        @default(0)
  leads       Int        @default(0)

  @@unique([campaignId, adId, date])
}

model UtmLink {
  id          String       @id @default(cuid())
  unitId      String
  unit        BusinessUnit @relation(fields: [unitId], references: [id])
  campaignId  String?
  campaign    AdCampaign?  @relation(fields: [campaignId], references: [id])
  destination String
  utmSource   String
  utmMedium   String
  utmCampaign String
  utmContent  String?
  shortCode   String       @unique
  clicks      Int          @default(0)
  createdAt   DateTime     @default(now())
}

/// Phase 2 social planner.
model SocialPost {
  id           String       @id @default(cuid())
  unitId       String
  unit         BusinessUnit @relation(fields: [unitId], references: [id])
  platforms    String[] // facebook | instagram | linkedin
  body         String
  mediaFileIds String[]
  scheduledAt  DateTime?
  publishedAt  DateTime?
  status       String       @default("draft")
  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  createdAt    DateTime     @default(now())
}
