// ─── Module H: Attendance (phone clock-in: geofence + selfie + device binding) ─

model Office {
  id        String            @id @default(cuid())
  unitId    String?
  unit      BusinessUnit?     @relation(fields: [unitId], references: [id])
  name      String // "Abuja HQ"
  address   String?
  latitude  Decimal           @db.Decimal(9, 6)
  longitude Decimal           @db.Decimal(9, 6)
  radiusM   Int               @default(100)
  timezone  String            @default("Africa/Lagos")
  isActive  Boolean           @default(true)
  staff     StaffProfile[]
  punches   AttendancePunch[]
}

enum DayStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKEND
  PENDING // day in progress
}

/// One row per staff per working day, derived from punches + schedule + leave + holidays.
model AttendanceDay {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  date            DateTime           @db.Date
  status          DayStatus          @default(PENDING)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  firstInAt       DateTime?
  lastOutAt       DateTime?
  minutesLate     Int                @default(0)
  minutesEarly    Int                @default(0) // signed off before scheduled close
  missingClockOut Boolean            @default(false) // clocked in, never out: flagged, not charged
  overtimeMinutes Int                @default(0)
  workedMinutes   Int                @default(0)
  isFlagged       Boolean            @default(false)
  payrollLockedAt DateTime? // set when payroll run closes; no further edits
  punches         AttendancePunch[]
  excuses         AttendanceExcuse[]
  deductions      Deduction[]

  @@unique([userId, date])
  @@index([date, status])
}

enum PunchType {
  IN
  OUT
}

enum ReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

/// Raw clock event. Suspicious punches are stored and flagged — never silently blocked.
model AttendancePunch {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("PunchOwner", fields: [userId], references: [id])
  dayId          String
  day            AttendanceDay @relation(fields: [dayId], references: [id])
  type           PunchType
  deviceTime     DateTime // time captured on the phone (offline mode)
  receivedAt     DateTime      @default(now()) // server time
  wasOffline     Boolean       @default(false)
  officeId       String?
  office         Office?       @relation(fields: [officeId], references: [id])
  latitude       Decimal?      @db.Decimal(9, 6)
  longitude      Decimal?      @db.Decimal(9, 6)
  accuracyM      Decimal?      @db.Decimal(8, 2)
  distanceM      Decimal?      @db.Decimal(10, 2)
  withinGeofence Boolean       @default(false)
  ip             String?
  userAgent      String?
  deviceId       String?
  device         Device?       @relation(fields: [deviceId], references: [id])
  deviceTrusted  Boolean       @default(false)
  selfieFileId   String?
  selfieHash     String? // perceptual/sha hash — detects re-used selfies
  flags          String[] // out_of_range, low_accuracy, unknown_device, mock_location, selfie_reused, clock_skew, no_selfie
  reviewStatus   ReviewStatus  @default(NOT_REQUIRED)
  reviewedById   String?
  reviewedBy     User?         @relation("PunchReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?

  @@index([userId, deviceTime])
  @@index([reviewStatus])
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  COMPASSIONATE
  UNPAID
  STUDY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation("LeaveOwner", fields: [userId], references: [id])
  type       LeaveType
  startDate  DateTime       @db.Date
  endDate    DateTime       @db.Date
  days       Decimal        @db.Decimal(5, 1)
  reason     String?
  status     ApprovalStatus @default(PENDING)
  approverId String?
  approver   User?          @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())
}

model PublicHoliday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

/// Staff excuse for a flagged / late / absent day — decided before payroll closes.
model AttendanceExcuse {
  id         String         @id @default(cuid())
  dayId      String
  day        AttendanceDay  @relation(fields: [dayId], references: [id])
  userId     String
  user       User           @relation("ExcuseOwner", fields: [userId], references: [id])
  reason     String
  fileId     String?
  status     ApprovalStatus @default(PENDING)
  reviewerId String?
  reviewer   User?          @relation("ExcuseReviewer", fields: [reviewerId], references: [id])
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())
}
