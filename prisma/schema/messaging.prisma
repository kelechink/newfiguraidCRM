// ─── Module R: Internal messaging, announcements, one-click tasks ─────────────

enum ChatChannelType {
  DIRECT
  GROUP
  UNIT
  PROJECT
}

model ChatChannel {
  id        String          @id @default(cuid())
  type      ChatChannelType
  name      String?
  unitId    String?
  unit      BusinessUnit?   @relation(fields: [unitId], references: [id])
  projectId String?
  project   Project?        @relation(fields: [projectId], references: [id])
  dmKey     String?         @unique // sorted "userA:userB" for DIRECT channels
  createdAt DateTime        @default(now())
  members   ChatMember[]
  messages  ChatMessage[]
}

model ChatMember {
  channelId         String
  userId            String
  channel           ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessageId String? // read receipts
  lastReadAt        DateTime?
  mutedUntil        DateTime?
  joinedAt          DateTime    @default(now())

  @@id([channelId, userId])
}

/// Retained for audit; readable by participants and Super Admin only.
model ChatMessage {
  id          String        @id @default(cuid())
  channelId   String
  channel     ChatChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  parentId    String? // thread reply
  parent      ChatMessage?  @relation("Thread", fields: [parentId], references: [id])
  replies     ChatMessage[] @relation("Thread")
  body        String
  kind        String        @default("text") // text | image | file | voice | task | system
  attachments Json? // [{fileId, mime, name, durationSec}]
  isPinned    Boolean       @default(false)
  editedAt    DateTime?
  deletedAt   DateTime? // soft delete; content retained for audit
  createdAt   DateTime      @default(now())
  task        Task?         @relation("MessageTask")
  mentions    ChatMention[]

  @@index([channelId, createdAt])
}

model ChatMention {
  messageId String
  userId    String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model Announcement {
  id            String            @id @default(cuid())
  title         String
  body          String
  requiresAck   Boolean           @default(true)
  unitId        String? // null = company-wide
  publishedById String
  publishedBy   User              @relation(fields: [publishedById], references: [id])
  publishedAt   DateTime          @default(now())
  pinnedUntil   DateTime?
  acks          AnnouncementAck[]
}

model AnnouncementAck {
  announcementId String
  userId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ackedAt        DateTime     @default(now())

  @@id([announcementId, userId])
}
