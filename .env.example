# Figuraid OS — copy to .env on the server and fill in. Never commit .env. Never paste these values in chat.
APP_NAME="Figuraid OS"
APP_ENV=production
APP_KEY=
# Old keys after a rotation (comma separated) so encrypted salaries/bank details stay readable:
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://figuraid.com
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel MySQL (create the database + user in cPanel → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_figuraid
DB_USERNAME=cpaneluser_fos
DB_PASSWORD=

# Shared-hosting friendly drivers (no Redis needed)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Email (cPanel mailbox or SMTP provider)
MAIL_MAILER=smtp
MAIL_HOST=mail.figuraid.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@figuraid.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@figuraid.com
MAIL_FROM_NAME="Figuraid"

# Public website contact details (leave blank until confirmed — nothing unverified is shown)
SITE_SALES_EMAIL=
SITE_SALES_PHONE=
SITE_LINKEDIN=
SITE_X=
SITE_INSTAGRAM=

# Cloudflare Turnstile CAPTCHA on public forms (optional but recommended)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI providers — free tiers, tried in this order (editable in Admin → Settings)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# Payments (read-only verification; webhooks are signature-checked and re-verified)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# FigureWeb WHMCS API (Setup → Staff Management → API Credentials; allow the server IP)
WHMCS_URL=https://figureweb.ng/clients
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
WHMCS_ACCESS_KEY=

# Meta (WhatsApp Cloud API for FigureWeb & Academy numbers, Instagram, Facebook)
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID_FIGUREWEB=
WHATSAPP_PHONE_ID_ACADEMY=
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Inbound email to the inbox (HMAC secret shared with the forwarding script/service)
INBOUND_EMAIL_SECRET=

# Brevo (email campaigns), Google Calendar
BREVO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Live updates: Pusher free tier (optional — the app polls every 15–30 s without it)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# Staff AI agents: mailboxes people can reply to (create them in cPanel → Email Accounts)
AGENT_MAILBOX_HR=hr@figuraid.com
AGENT_MAILBOX_FINANCE=accounts@figuraid.com
AGENT_MAILBOX_GM=gm@figuraid.com

# Local demo only
DEMO_PASSWORD=
