# Figuraid OS — copy to .env and fill in. Never commit .env.
# Use separate keys for development and production.

# Core
DATABASE_URL="postgresql://figuraid:figuraid@localhost:5432/figuraid"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""                 # openssl rand -base64 32
# Field-level encryption keys (AES-256-GCM, base64 32 bytes). Newest version encrypts; older decrypt.
FIELD_ENCRYPTION_KEYS="v1:"        # e.g. v1:<base64>,v2:<base64>
FIELD_ENCRYPTION_ACTIVE="v1"

# File storage (S3-compatible, private bucket)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"

# Public endpoint protection
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Paystack
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# WHMCS
WHMCS_API_URL=""
WHMCS_API_IDENTIFIER=""
WHMCS_API_SECRET=""
WHMCS_WEBHOOK_SECRET=""

# Brevo
BREVO_API_KEY=""
BREVO_WEBHOOK_TOKEN=""
BREVO_SENDER_EMAIL="hello@figuraid.com"

# Meta (WhatsApp x2, Facebook, Instagram, Ads)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_FIGUREWEB_PHONE_NUMBER_ID=""
WHATSAPP_ACADEMY_PHONE_NUMBER_ID=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# AI (public knowledge only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GROQ_API_KEY=""
AI_DAILY_REQUEST_LIMIT="1500"
AI_PER_MINUTE_LIMIT="10"

# ── Exchange rates ───────────────────────────────────────────────────────────
# Parallel-market rates are researched daily by the AI (needs GEMINI_API_KEY, uses Google Search grounding).
# Optional official-rate feed based on NGN, e.g. https://open.er-api.com/v6/latest/NGN
FX_API_URL=""

# ── Company details used in documents and links ───────────────────────────────
COMPANY_ADDRESS="Kano House, 72 Ralph Shodeinde Street, Central Business District, Abuja"
# Where /r/CODE referral links land (your public website)
REFERRAL_LANDING_URL="https://figuraid.com"
